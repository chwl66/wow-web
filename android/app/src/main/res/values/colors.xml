<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 品牌色：与游戏暗黑魔兽风一致（css/style.css 的变量） -->
    <color name="colorPrimary">#0a0a0c</color>
    <color name="colorPrimaryDark">#0a0a0c</color>
    <color name="colorAccent">#f0c75e</color>

    <!-- 窗口背景：启动避免白屏闪烁 -->
    <color name="window_background">#0a0a0c</color>

    <!-- 系统栏（Android 15 强制 edge-to-edge 前生效；其上层由 WebView safe-area 接管） -->
    <color name="status_bar_color">#0a0a0c</color>
    <color name="navigation_bar_color">#0a0a0c</color>

    <!-- Android 12+ SplashScreen 背景 -->
    <color name="splash_background">#0a0a0c</color>

</resources>
